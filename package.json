{
	"name": "ai-game-poc",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "react-router build",
		"dev": "react-router dev",
		"typecheck": "wrangler types && react-router typegen && tsc -b",
		"deploy": "pnpm run build && wrangler deploy",
		"db:migrate:remote": "wrangler d1 migrations apply ai-game-poc-db --remote",
		"preview": "pnpm run build && vite preview",
		"cf-typegen": "wrangler types",
		"postinstall": "wrangler types",
		"check": "biome check",
		"check:fix": "biome check --write",
		"test": "vitest run"
	},
	"dependencies": {
		"isbot": "^5.1.36",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router": "^8.3.1",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@cloudflare/vite-plugin": "^1.56.0",
		"@cloudflare/vitest-plugin": "^1.2.1",
		"@react-router/dev": "^8.3.1",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^22",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"tailwindcss": "^4.2.2",
		"typescript": "^5.9.3",
		"vite": "^8.0.3",
		"vitest": "^4.1.11",
		"wrangler": "^4.135.0"
	}
}
